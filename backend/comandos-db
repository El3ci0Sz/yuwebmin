# ── Começando o dia ──────────────────────
docker compose up -d          # sobe sem rebuildar (rápido ~5s)

# ── Fez alteração no código ──────────────
docker compose up -d --build  # rebuilda só o que mudou (~30s)

# ── Puxou do GitHub ──────────────────────
git pull
docker compose up -d --build  # rebuilda com as mudanças do pull

# ── Acabou o dia ─────────────────────────
docker compose stop           # para tudo, libera memória